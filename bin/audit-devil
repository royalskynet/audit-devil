#!/usr/bin/env python3
"""audit-devil — have a second model audit and post-mortem your work, then verify what it said.

Pipeline (one bundle directory per run):
  bundle  collect the material + write the devil's-advocate prompt
  send    hand the prompt to the second model (OpenBot agent, or any CLI)
  collect fetch the report when the model answers in a later turn (OpenBot only)
  check   parse the report, prove every `evidence:` line points at real code,
          and emit a verdict skeleton for the operator to rule on

The point of `check`: a second model that cannot be checked is a second opinion
you cannot use. Findings without resolvable evidence are marked UNVERIFIED and
the exit code is non-zero, so a fabricated audit fails loudly instead of being
believed.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
SKILL = Path(os.environ.get("OPENBOT_SKILL_DIR", HOME / ".claude/skills/send-to-openbot"))
BUILDER = "agent-fc4b4efb-184a-4a25-b0e6-24b2d934f670"  # OpenBot Builder (ID stable across renames)

# A preset is just "how to reach the second model".
#   kind=openbot -> OpenBot agent, answers arrive in a later turn (needs `collect`)
#   kind=cmd     -> any CLI: prompt on stdin, report on stdout (synchronous), e.g.
#                   simonw/llm (`llm -m <model>`), `codex exec -`, `gemini -p ""`
#   OpenBot users with another agent: OPENBOT_AGENT=<id> overrides the builder preset.
PRESETS = {
    "builder": {"kind": "openbot", "agent": BUILDER, "out": HOME / "OpenBot/Shared/audit-devil"},
    "cmd": {"kind": "cmd", "cmd": None, "out": None},
}
DEFAULT_PRESET = os.environ.get("AUDIT_DEVIL_PRESET", "builder")

SPEC = """\
You are the devil's advocate on this change. Your job is to find what is wrong
with it and to explain why nobody caught it. You are not here to approve it.

Two halves, both required:

AUDIT — defects in the material itself: wrong logic, unhandled failure, unsafe
input, race, silent fallback, dead or speculative code, a simpler correct form.
POST-MORTEM — for each defect answer: where else does this pattern appear in the
material, which layer should have stopped it (test, type, guard, hook, review),
and under what conditions it gets written again.

Rules:
- Every finding must cite real locations from the material as `path:line` or
  `path:line-line`. Paths are relative to the material root. A finding you
  cannot locate in the material does not go in the report.
- No praise, no summary of what the code does, no restating the task.
- If you believe the change is sound, say so in `## Verdict` and report only the
  findings you can actually evidence. An empty findings list is a valid answer.
- Rank findings highest severity first.
- Do a full pass before answering; do not stop at the first valid finding.
- Do not report style, formatting, lint or type-check issues, and no generic
  advice such as "add more tests". Only what genuinely matters.

Output format, exactly this, nothing before or after:

## Verdict
<one or two sentences: ship / fix first / cannot tell, and why>

### F1 <short title>
severity: high|medium|low
kind: audit|postmortem
action: auto-fix|ask-user|no-op
evidence: <path:line>[, <path:line-line> ...]
claim: <what is wrong, one or two sentences>
why-not-caught: <which layer was missing>
fix: <smallest change that fixes the cause, not the symptom>

action: auto-fix = correctness, error handling, security, performance — fixable
without discussing intent. ask-user = product behaviour or the author's deliberate
intent; when in doubt, ask-user. no-op = informational.

### F2 ...
"""

FINDING_RE = re.compile(r"^###\s+(F\d+)\s*(.*)$")
FIELD_RE = re.compile(r"^(severity|kind|action|evidence|claim|why-not-caught|fix)\s*:\s*(.*)$", re.I)
LOC_RE = re.compile(r"^(?P<path>[^\s:]+):(?P<a>\d+)(?:\s*-\s*(?P<b>\d+))?$")


def die(msg, code=2):
    print(f"audit-devil: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, **kw):
    return subprocess.run(cmd, text=True, capture_output=True, **kw)


def preset(name, need_cmd=False):
    """need_cmd: only `send` actually has to reach the model, so only `send` requires the command."""
    if name not in PRESETS:
        die(f"unknown preset {name!r}; have: {', '.join(PRESETS)}")
    p = dict(PRESETS[name])
    if p["kind"] == "cmd":
        p["cmd"] = os.environ.get("AUDIT_DEVIL_CMD")
        if need_cmd and not p["cmd"]:
            die("preset 'cmd' needs AUDIT_DEVIL_CMD, e.g."
                " AUDIT_DEVIL_CMD='claude -p --model claude-sonnet-5-5'")
        p["out"] = Path(os.environ.get("AUDIT_DEVIL_OUT", ".audit-devil"))
    return p


# ---------------------------------------------------------------- bundle

def cmd_bundle(a):
    p = preset(a.preset)
    root = Path(a.root).resolve()
    if not root.is_dir():
        die(f"--root {root} is not a directory")
    if not (a.diff or a.file or a.incident):
        die("nothing to audit: give --diff, --file and/or --incident")

    base = Path(a.out) if a.out else Path(os.environ.get("AUDIT_DEVIL_OUT", p["out"]))
    bundle = base / (a.id or time.strftime("%Y%m%d-%H%M%S"))
    mat = bundle / "material"
    mat.mkdir(parents=True, exist_ok=True)

    parts = []
    if a.diff:
        r = run(["git", "-C", str(root), "diff", "--unified=8", a.diff])
        if r.returncode:
            die(f"git diff {a.diff} failed: {r.stderr.strip()}")
        if not r.stdout.strip():
            die(f"git diff {a.diff} is empty")
        (mat / "diff.patch").write_text(r.stdout)
        parts.append("material/diff.patch — the change under audit (unified diff, 8 lines of context)")
        # Line numbers in a patch are not line numbers in a file, so the changed
        # files go in whole: that is what makes `evidence:` checkable later.
        names = run(["git", "-C", str(root), "diff", "--name-only", a.diff]).stdout.split()
        for n in names:
            src = root / n
            if not src.is_file() or src.stat().st_size > 512_000:
                continue
            dst = mat / "files" / n
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
            parts.append(f"material/files/{n} — full file after the change")
    for f in a.file or []:
        src = (root / f).resolve() if not Path(f).is_absolute() else Path(f)
        if not src.is_file():
            die(f"--file {f}: no such file")
        try:
            rel = src.relative_to(root)
        except ValueError:
            rel = Path(src.name)
        dst = mat / "files" / rel
        if dst.exists():
            die(f"--file {f}: material/files/{rel} already taken by another file; copy it under --root")
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)
        parts.append(f"material/files/{rel} — full current file")
    if a.incident:
        src = Path(a.incident)
        if not src.is_file():
            die(f"--incident {a.incident}: no such file")
        shutil.copy2(src, mat / "incident.txt")
        parts.append("material/incident.txt — verbatim failure output / incident record")

    lang = a.lang or os.environ.get("AUDIT_DEVIL_LANG", "zh-TW")
    task = [f"# Audit + post-mortem request ({bundle.name})", "",
            "## Material", f"Material root: {mat}", ""]
    task += [f"- {x}" for x in parts]
    task += ["", "Read every file listed above in full before you write anything.", ""]
    if a.note:
        task += ["## Context from the operator", a.note, ""]
    task += ["## What to do", "", SPEC, "", f"Write prose in {lang}. Keep field names and the"
             " heading format exactly as shown in English.", ""]
    report_hint = ""
    if p["kind"] == "openbot":
        report_hint = (f"Write your report to {bundle}/report.md and also paste it as your reply."
                       " You can read and write inside OpenBot/Shared; do not try to read anything"
                       " outside the material root.")
        task += ["## Where to put the report", report_hint, ""]
    (bundle / "task.md").write_text("\n".join(task))
    (bundle / "meta.json").write_text(json.dumps({
        "id": bundle.name, "preset": a.preset, "kind": p["kind"], "root": str(root),
        "material": str(mat), "diff": a.diff, "files": a.file or [],
        "incident": a.incident, "lang": lang, "created": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    }, indent=2, ensure_ascii=False))
    print(bundle)


# ---------------------------------------------------------------- send

def load(bundle):
    b = Path(bundle)
    mf = b / "meta.json"
    if not mf.is_file():
        die(f"{bundle} is not a bundle (no meta.json)")
    return b, json.loads(mf.read_text())


def inline(task, mat):
    """task.md plus every material file, line-numbered so citations can be exact."""
    out = [task, "", "## Material contents (inlined — do not try to open these paths)", ""]
    for f in sorted(x for x in mat.rglob("*") if x.is_file()):
        rel = f.relative_to(mat)
        lines = f.read_text(errors="replace").splitlines()
        out += [f"### {rel}", "```"] + [f"{i}\t{s}" for i, s in enumerate(lines, 1)] + ["```", ""]
    return "\n".join(out)


def cmd_send(a):
    b, meta = load(a.bundle)
    task = (b / "task.md").read_text()
    p = preset(meta["preset"], need_cmd=True)
    if p["kind"] == "openbot":
        env = dict(os.environ, OPENBOT_TASK_ID=f"ad-{meta['id']}")
        env.setdefault("OPENBOT_AGENT", p["agent"])
        env.setdefault("OPENBOT_TIMEOUT", "45m")
        r = subprocess.run(["bash", str(SKILL / "send.sh"), "-"], input=task, text=True, env=env,
                           capture_output=True)
        (b / "send.log").write_text(f"rc={r.returncode}\n--- stdout\n{r.stdout}\n--- stderr\n{r.stderr}")
        # send.sh: 0 done, 3 already done <30m, 4 timed out but running, 6 waiting for approval —
        # only these mean the task exists on the other side, so only these get a task_id to collect.
        if r.returncode not in (0, 3, 4, 6):
            die(f"send.sh exited {r.returncode}, nothing delivered; see {b}/send.log", 1)
        meta["task_id"] = env["OPENBOT_TASK_ID"]
        (b / "meta.json").write_text(json.dumps(meta, indent=2, ensure_ascii=False))
        if r.returncode == 0 and r.stdout.strip() and not (b / "report.md").is_file():
            (b / "report.md").write_text(r.stdout)
        print(f"task_id={meta['task_id']} rc={r.returncode} (collect with: audit-devil collect {b})",
              file=sys.stderr)
        sys.exit(r.returncode)
    # A plain stdin model has no file tools, and agentic CLIs sandbox paths outside their
    # cwd (opencode auto-rejects them) — either way a path list makes it guess. Inline it.
    r = subprocess.run(p["cmd"], shell=True, input=inline(task, Path(meta["material"])),
                       text=True, capture_output=True)
    (b / "send.stderr.log").write_text(r.stderr or "")
    if r.returncode != 0:
        die(f"second model exited {r.returncode}; stderr in {b}/send.stderr.log", 1)
    if not r.stdout.strip():
        die(f"second model produced no output; stderr in {b}/send.stderr.log", 1)
    (b / "report.md").write_text(r.stdout)
    print(b / "report.md")


def cmd_collect(a):
    b, meta = load(a.bundle)
    if (b / "report.md").is_file() and not a.force:
        print(b / "report.md")
        return
    tid = meta.get("task_id")
    if not tid:
        die("no task_id in meta.json — run `send` first")
    r = run(["bash", str(SKILL / "check.sh"), tid, str(a.wait)])
    if r.returncode == 1:
        die("the second model has not answered yet; try again later", 1)
    if r.returncode:
        die(f"check.sh exited {r.returncode}: {(r.stderr or r.stdout).strip()[:400]}", 1)
    (b / "report.md").write_text(r.stdout)
    print(b / "report.md")


# ---------------------------------------------------------------- check

def parse_report(text):
    findings, cur = [], None
    for line in text.splitlines():
        m = FINDING_RE.match(line)
        if m:
            cur = {"id": m.group(1), "title": m.group(2).strip(), "evidence": "", "severity": "",
                   "kind": "", "action": "", "claim": "", "why-not-caught": "", "fix": ""}
            findings.append(cur)
            continue
        if cur:
            f = FIELD_RE.match(line.strip())
            if f:
                cur[f.group(1).lower()] = f.group(2).strip()
    return findings


def locate(root, spec):
    """Resolve one `path:line[-line]` against root. Returns (status, detail, quote).

    A second model cites the path it saw, which may be material-relative
    (`files/src/a.js`) or repo-relative (`src/a.js`); both resolve here. Nothing
    outside the material root resolves — an unresolvable citation is a finding
    you cannot check, which is the whole point of this step.
    """
    m = LOC_RE.match(spec.strip())
    if not m:
        return "BADFORM", f"not path:line — {spec!r}", []
    root = root.resolve()
    rel = m.group("path").lstrip("/")
    for cand in (root / rel, root / "files" / rel):
        try:
            real = cand.resolve()
            real.relative_to(root)
        except ValueError:
            return "OUTSIDE", f"{rel} is outside the material root", []
        except (OSError, RuntimeError) as e:  # symlink loop and friends
            return "MISSING", f"{rel} cannot be resolved: {e}", []
        if real.is_file():
            path = real
            break
    else:
        return "MISSING", f"{rel} does not exist in the material", []
    lines = path.read_text(errors="replace").splitlines()
    a = int(m.group("a"))
    b = int(m.group("b") or a)
    if a < 1 or b < a or b > len(lines):
        return "OUTOFRANGE", f"{m.group('path')} has {len(lines)} lines, cited {a}-{b}", []
    return "OK", f"{m.group('path')}:{a}-{b}", [(i, lines[i - 1]) for i in range(a, b + 1)]


def cmd_check(a):
    b, meta = load(a.bundle)
    rep = b / "report.md"
    if not rep.is_file():
        die(f"no report yet: {rep}")
    root = Path(a.material or meta["material"])
    findings = parse_report(rep.read_text())
    out = [f"# Checked findings — {meta['id']}", "",
           f"report: {rep}", f"material root: {root}", ""]
    text = rep.read_text()
    clean = not findings and re.search(r"^##\s+Verdict\s*$", text, re.M) is not None
    if clean:
        out += ["Clean verdict: the report has `## Verdict` and no findings. That is a valid",
                "answer, not proof of absence — read the verdict line before trusting it.", ""]
    elif not findings:
        out += ["No `## Verdict` and no finding blocks: the second model ignored the format.", ""]
    bad = 0
    verdict = [f"# Verdict — {meta['id']}", "",
               "Rule on every finding. accept = you confirmed it and will fix it;",
               "reject = you confirmed it is wrong (say why); defer = real but out of scope.", ""]
    for f in findings:
        specs = [s for s in re.split(r"[,;]", f["evidence"]) if s.strip()]
        out += [f"## {f['id']} {f['title']}",
                f"severity: {f['severity'] or '(missing)'} | kind: {f['kind'] or '(missing)'}"
                f" | action: {f['action'] or '(missing)'}",
                f"claim: {f['claim'] or '(missing)'}",
                f"why-not-caught: {f['why-not-caught'] or '(missing)'}",
                f"fix: {f['fix'] or '(missing)'}", ""]
        if not specs:
            out += ["evidence: **UNVERIFIED — no evidence cited**", ""]
            bad += 1
        for s in specs:
            status, detail, quote = locate(root, s)
            if status != "OK":
                bad += 1
                out += [f"evidence {s.strip()}: **UNVERIFIED ({status})** — {detail}", ""]
                continue
            out += [f"evidence {detail}: OK", "", "```"]
            out += [f"{i:>6}\t{txt}" for i, txt in quote]
            out += ["```", ""]
        verdict += [f"## {f['id']} {f['title']}", "decision: TODO", "reason: ", ""]
    checked = b / "checked.md"
    checked.write_text("\n".join(out))
    vf = b / "verdict.md"
    if not vf.is_file():
        vf.write_text("\n".join(verdict))
    print(checked)
    print(f"findings={len(findings)} unverified={bad}", file=sys.stderr)
    if bad or not (findings or clean):
        sys.exit(1)


def main():
    ap = argparse.ArgumentParser(prog="audit-devil", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="c", required=True)

    pb = sub.add_parser("bundle", help="collect material and write the prompt")
    pb.add_argument("--root", default=".", help="repo the material comes from (default: cwd)")
    pb.add_argument("--diff", help="git range to audit, e.g. HEAD~1..HEAD or main...HEAD")
    pb.add_argument("--file", action="append", help="whole file to include (repeatable)")
    pb.add_argument("--incident", help="file holding verbatim failure output")
    pb.add_argument("--note", help="context the second model cannot infer")
    pb.add_argument("--preset", default=DEFAULT_PRESET, help=f"second model (default: {DEFAULT_PRESET})")
    pb.add_argument("--lang", help="language for the report prose (default zh-TW)")
    pb.add_argument("--out", help="bundle parent directory")
    pb.add_argument("--id", help="bundle name (default: timestamp)")
    pb.set_defaults(fn=cmd_bundle)

    ps = sub.add_parser("send", help="hand the prompt to the second model")
    ps.add_argument("bundle")
    ps.set_defaults(fn=cmd_send)

    pc = sub.add_parser("collect", help="fetch the report (OpenBot presets)")
    pc.add_argument("bundle")
    pc.add_argument("--wait", type=int, default=0, help="seconds to wait for the reply")
    pc.add_argument("--force", action="store_true", help="refetch even if report.md exists")
    pc.set_defaults(fn=cmd_collect)

    pk = sub.add_parser("check", help="verify every cited location; exit 1 if any is unverified")
    pk.add_argument("bundle")
    pk.add_argument("--material", help="override the material root")
    pk.set_defaults(fn=cmd_check)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
